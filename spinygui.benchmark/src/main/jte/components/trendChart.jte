@import com.spinyowl.spinygui.benchmark.report.BenchmarkReportView
@param BenchmarkReportView.TrendSeries series
<figure class="trend-chart"><figcaption>${series.label()} (${series.unit()})</figcaption><svg viewBox="0 0 1200 720" aria-labelledby="${series.id()}-title ${series.id()}-description"><title id="${series.id()}-title">${series.label()} trend</title><desc id="${series.id()}-description">Values range from ${series.minimum()} to ${series.maximum()} ${series.unit()}. Timeline starts ${series.timelineFirstRun()} and ends ${series.timelineLastRun()}.</desc><path class="trend-grid" d="M100 80H1100M100 215H1100M100 350H1100M100 485H1100M100 620H1100M100 80V620M1100 80V620"/>@if(series.points().isEmpty())<text class="trend-label" x="600" y="350" text-anchor="middle">No matching runs</text>@endif@if(series.points().size() == 1)<text class="trend-label" x="600" y="350" text-anchor="middle">One matching run</text>@endif@for(var segment : series.segments())@if(segment.points().size() > 1)<polyline class="trend-line" points="@for(var point : segment.points())${point.x()},${point.y()} @endfor"/>@endif@endfor@for(var point : series.points())<circle class="trend-point" cx="${point.x()}" cy="${point.y()}" r="8" tabindex="0" aria-label="${point.accessibleLabel()}"><title>${point.accessibleLabel()}</title></circle>@endfor<text class="trend-label" x="100" y="675">${series.timelineFirstRun()}</text>@if(series.timelineFirstRun().equals(series.timelineLastRun()))@else<text class="trend-label" x="1100" y="675" text-anchor="end">${series.timelineLastRun()}</text>@endif<text class="trend-label" x="85" y="90" text-anchor="end">${series.maximum()}</text><text class="trend-label" x="85" y="630" text-anchor="end">${series.minimum()}</text></svg></figure>
