<winframe>
  <div class="panel vertical-scroll">
    <div class="title">Vertical auto</div>
    <div class="tall-content">Scroll down for more vertical content. A B C D E F G H I J.</div>
  </div>

  <div class="panel horizontal-scroll">
    <div class="title">Horizontal auto</div>
    <div class="wide-content">Scroll right to reveal the rest of this long horizontal line.</div>
  </div>

  <div class="panel nested-scroll">
    <div class="title">Nested auto</div>
    <div class="inner-scroll">
      <div class="wide-content">Inner wide content for horizontal nested scrolling.</div>
      <div class="tall-content">Inner tall content for vertical nested scrolling.</div>
    </div>
  </div>

  <div class="panel visible-overflow">
    <div class="title">Visible overflow</div>
    <div class="oversized-card">This card should paint outside the green panel.</div>
  </div>

  <div class="panel two-axis-scroll">
    <div class="title">Two-axis styled</div>
    <div class="two-axis-content">Drag either scrollbar. This content is both wide and tall.</div>
  </div>

  <div class="panel forced-scroll">
    <div class="title">Forced scroll</div>
    <div class="small-content">Content fits, but overflow scroll still reserves gutters.</div>
  </div>

  <div class="panel auto-fit">
    <div class="title">Auto fits</div>
    <div class="small-content">No scrollbar should appear here.</div>
  </div>

  <div class="panel auto-overflow">
    <div class="title">Auto overflows</div>
    <div class="tall-content">The same auto rule scrolls when content exceeds this fixed box.</div>
  </div>
</winframe>
