<winframe>
    <div class="title">Grid Style Demo</div>
    <div class="subtitle">Visible cards below are laid out by the grid formatting context.</div>

    <div id="visual-stage" class="visual-stage">
        <div id="featured-card" class="visual-card featured-card">Featured spans the wide area</div>
        <div id="summary-card" class="visual-card summary-card">Summary area</div>
        <div id="actions-card" class="visual-card actions-card">Actions column</div>
    </div>

    <div class="contract-panel">
        <div class="contract-title">Resolved declarations</div>
        <div class="contract-row row-display">display: grid</div>
        <div class="contract-row row-columns">columns: 160px 1fr minmax(120px, 2fr)</div>
        <div class="contract-row row-rows">rows: 80px auto</div>
        <div class="contract-row row-areas">areas: featured / summary / actions</div>
        <div class="contract-row row-gap">gap: 12px 18px</div>
    </div>

    <div id="m7-grid-panel" class="m7-grid-panel">
        <div class="m7-title">M7 aligned intrinsic panel</div>
        <div class="m7-summary">Auto track: this clipped summary keeps its final width while the panel is resized.</div>
        <div class="m7-controls">
            <input id="m7-check" type="checkbox" name="grid-proof" value="enabled" />
            <button id="m7-apply" type="button">Apply</button>
        </div>
        <div id="m7-scroll" class="m7-scroll">
            <div class="m7-scroll-content">Scrollable content stays clipped to this final Grid cell. Resize the window, then scroll both directions to check the container bounds.</div>
        </div>
    </div>
</winframe>
