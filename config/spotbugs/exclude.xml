<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Generated by ANTLR; analyze the handwritten parser integration instead. -->
    <Match>
        <Class name="~com\.spinyowl\.spinygui\.core\.parser\.impl\.css\.antlr\..*"/>
    </Match>

    <!-- Existing production findings are tracked explicitly so new findings still fail the build. -->
    <Match>
        <Class name="com.spinyowl.spinygui.core.style.types.Color"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <Match>
        <Class name="com.spinyowl.spinygui.core.style.types.transition.TransitionTimingFunction"/>
        <Bug pattern="IC_SUPERCLASS_USES_SUBCLASS_DURING_INITIALIZATION"/>
    </Match>
    <Match>
        <Class name="com.spinyowl.spinygui.core.backend.renderer.lwjgl.nanovg.NvgScrollbarRenderer"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>
    <Match>
        <Class name="com.spinyowl.spinygui.demo.complex.Demo"/>
        <Bug pattern="DM_GC"/>
    </Match>

    <!-- Contract tests intentionally pass null and retain values solely to exercise behavior. -->
    <Match>
        <Class name="~.*Test(\$.*)?"/>
        <Bug pattern="NP_NONNULL_PARAM_VIOLATION,DLS_DEAD_LOCAL_STORE"/>
    </Match>
</FindBugsFilter>
